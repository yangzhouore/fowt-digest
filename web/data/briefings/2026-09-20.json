    {
      "briefingItemId": "eng-item-2026-09-20-02",
      "title": "Celtic Sea acoustic monitoring targets floating wind evidence gap",
      "oneLineSummary": "ORE Catapult launched SubSea Soundscape to map marine mammal behaviour and underwater noise for Celtic Sea floating wind planning.",
      "category": "technology",
      "region": "Europe",
