      "publisher": "offshoreWIND.biz",
      "title": "TetraSpar Floater Completes Five-Year Testing Campaign Offshore Norway",
      "sourceUrl": "https://www.offshorewind.biz/2026/09/08/tetraspar-floater-completes-five-year-testing-campaign-offshore-norway",
      "publishedDate": "2026-09-08",
      "retrievedAt": "2026-10-05T12:00:00Z",
      "collectionMethod": "manual",
      "sourceText": "The TetraSpar Demonstrator completed nearly five years at METCentre and was disconnected from moorings and towed inshore. The 3.6 MW turbine operated at 200 metres water depth, achieving 98 per cent average availability, 51.4 per cent lifetime capacity factor and about 70 million kWh generated, with components to be inspected against 40,000+ hours of operating data.",
      "licenseNote": "Public trade-press webpage; reuse terms not yet reviewed."
    },
    {
      "sourceRecordId": "eng-src-2026-09-13-ardersier-bw-ideol-feed",
      "candidateStatus": "candidate",
      "sourceType": "company_announcement",
      "publisher": "BW Ideol",
      "title": "BW Ideol secures first public sector backing for its Ardersier floating foundation factory",
      "sourceUrl": "https://www.bw-ideol.com/en/bw-ideol-secures-first-public-sector-backing-its-ardersier-floating-foundation-factory",
      "publishedDate": "2026-09-07",
      "retrievedAt": "2026-10-05T12:00:00Z",
      "collectionMethod": "manual",
      "sourceText": "BW Ideol says Highlands and Islands Enterprise approved more than GBP 778,000 in Scottish Government funding for the FEED study for BW Ideol's planned floating foundation manufacturing facility at Port of Ardersier. The planned facility is dedicated to serial production of Damping Pool concrete floating foundations and is designed to deliver one foundation every 12 days from a single production line.",
      "licenseNote": "Public company webpage; reuse terms not yet reviewed."
    },
    {
      "sourceRecordId": "eng-src-2026-09-13-t12-floating-mooring-system",
      "candidateStatus": "candidate",
      "sourceType": "industry_news",
      "publisher": "Ocean News & Technology",
      "title": "T12 Engineering Wins OWGP Funding to Advance Floating Wind Mooring System",
      "sourceUrl": "https://oceannews.com/news/energy/t12-engineering-wins-owgp-funding-to-advance-floating-wind-mooring-system/",
      "publishedDate": "2026-09-08",
      "retrievedAt": "2026-10-05T12:00:00Z",
      "collectionMethod": "manual",
      "sourceText": "T12 Engineering secured Offshore Wind Growth Partnership funding to further develop its Floating Mooring System for floating offshore wind turbine maintenance. The project builds on a FEED study supported by Scottish Enterprise in 2025 and targets safer, more efficient maintenance with less reliance on heavy-lift vessels and tow-to-shore repairs.",
      "licenseNote": "Public trade-press webpage; reuse terms not yet reviewed."
    }
  ],
  "briefingItems": [
    {
      "briefingItemId": "eng-item-2026-09-13-03",
      "title": "T12 wins OWGP backing for floating mooring maintenance system",
      "oneLineSummary": "T12 Engineering secured OWGP support to advance a Floating Mooring System intended to reduce floating wind maintenance cost and vessel dependence.",
      "category": "technology",
      "region": "Europe",
      "sourceRecordIds": [
        "eng-src-2026-09-13-t12-floating-mooring-system"
      ],
      "sourceUrl": "https://oceannews.com/news/energy/t12-engineering-wins-owgp-funding-to-advance-floating-wind-mooring-system/",
      "explanation": "The work follows a Scottish Enterprise-supported FEED study and targets safer offshore major maintenance without relying as heavily on heavy-lift vessels or towing turbines to shore.",
      "whyItMatters": "Maintainability is a major cost and availability issue for floating wind farms moving into deeper, more remote waters.",
      "engineeringTopics": [
        "Floating mooring",
        "Major component maintenance",
        "Installation tools"
      ]
    },
    {
      "briefingItemId": "eng-item-2026-09-13-02",
      "title": "Ardersier floating foundation factory moves into FEED",
      "oneLineSummary": "Scottish public backing will support BW Ideol's FEED study for serial concrete floating foundation production at Port of Ardersier.",
      "category": "supply_chain",
      "region": "Europe",
      "sourceRecordIds": [
        "eng-src-2026-09-13-ardersier-bw-ideol-feed"
      ],
      "sourceUrl": "https://www.bw-ideol.com/en/bw-ideol-secures-first-public-sector-backing-its-ardersier-floating-foundation-factory",
      "explanation": "The facility concept is designed around gantry slipforming, precast and automated prefabrication for Damping Pool concrete floaters.",
      "whyItMatters": "Serial floating foundation manufacturing capacity is a bottleneck for commercial floating wind projects such as Buchan.",
      "engineeringTopics": [
        "Concrete floating foundation",
        "Port fabrication",
        "Serial manufacturing"
      ]
    },
    {
      "briefingItemId": "eng-item-2026-09-13-01",
      "title": "TetraSpar ends five-year Norway test campaign",
      "oneLineSummary": "TetraSpar completed its METCentre campaign and moved into inspection after almost five years of full-scale floating wind operation.",
      "category": "technology",
      "region": "Europe",
      "sourceRecordIds": [
        "eng-src-2026-09-13-tetraspar-five-year-campaign"
      ],
      "sourceUrl": "https://www.offshorewind.biz/2026/09/08/tetraspar-floater-completes-five-year-testing-campaign-offshore-norway",
      "explanation": "The campaign covered modular assembly, tow-out, hook-up, operation, disconnection and export-cable wet storage for a full-scale floating foundation.",
      "whyItMatters": "Physical inspection after long operation gives rare evidence for validating lifetime design assumptions in modular floating foundations.",
      "engineeringTopics": [
        "Floating foundation",
        "Operations data",
        "Decommissioning"
      ]
